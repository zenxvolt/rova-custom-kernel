# Required for KernelSU-Next / SukiSU-Ultra / ReSukiSU kprobe-based hooks.
# arch/arm64/Kconfig already `select`s HAVE_KPROBES and this tree ships
# arch/arm64/kernel/probes/kprobes.c, so plain kprobes is architecturally
# supported here - it's just not turned on in rova_defconfig by default.

CONFIG_KSU=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# KPROBES depends on MODULES on some kernel configs; already =y in
# rova_defconfig, kept here for safety/documentation.
CONFIG_MODULES=y

# Master switch for SUSFS after susfs4ksu's kernel-4.9 patch has been
# applied by the workflow's experimental SUSFS step. Most CONFIG_KSU_SUSFS_*
# sub-features default to y once this is enabled, but the exact sub-option
# list can vary between susfs releases - after setup.sh + the susfs patch
# have run, check KernelSU/kernel/Kconfig in the build log / a local clone
# for the full list if you want to fine-tune (e.g. disable SUS_SU, which
# susfs4ksu's own docs say is unsupported for non-GKI hook mode).
CONFIG_KSU_SUSFS=y

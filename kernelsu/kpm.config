# KPM (Kernel Patch Module) support - SukiSU-Ultra / ReSukiSU only.
# Lets you load small kernel patches later without recompiling the whole
# kernel. CONFIG_KALLSYMS_ALL is already =y in rova_defconfig; CONFIG_KALLSYMS
# is required alongside it for non-GKI devices per SukiSU-Ultra's docs.

CONFIG_KPM=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
